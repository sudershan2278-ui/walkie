# Copy to bridge/bridge.env and fill in. Keep this file private (chmod 600).
WALKIE_SERVER=wss://your-walkie-server.example.com/ws
WALKIE_CHANNEL=1
WALKIE_PASSCODE=change-me-to-the-channel-passcode
WALKIE_NAME=Radio bridge

# AIOC cable defaults. Run `arecord -l` to find your sound card name.
PTT_MODE=aioc
PTT_DEVICE=/dev/ttyACM0
CAPTURE_CMD=arecord -q -D plughw:CARD=AllInOneCable,DEV=0 -f S16_LE -r 16000 -c 1 -t raw --buffer-time=40000
PLAYBACK_CMD=aplay -q -D plughw:CARD=AllInOneCable,DEV=0 -f S16_LE -r 16000 -c 1 -t raw --buffer-time=80000

# Tuning
VOX_THRESHOLD_DB=-38
VOX_HANG_MS=900
PTT_LEAD_MS=150
