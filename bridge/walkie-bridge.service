# systemd unit for the radio bridge on a Raspberry Pi.
# Install: sudo cp bridge/walkie-bridge.service /etc/systemd/system/ && sudo systemctl enable --now walkie-bridge
[Unit]
Description=Walkie radio bridge
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/walkie
EnvironmentFile=/home/pi/walkie/bridge/bridge.env
ExecStart=/usr/bin/node bridge/bridge.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
